<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled: local distribution only (kein App Store).
	     Erlaubt frei wählbare Vault-Ordner, die auch nach App-Neustart
	     zugänglich bleiben (Sandbox vergisst user-selected-Freigaben). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Sync server: listen on local network -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Sync client: connect to local network peers -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Vault: read/write user-chosen folder -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Downloads folder for backup exports -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Camera access (barcode scanner / OCR) -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
