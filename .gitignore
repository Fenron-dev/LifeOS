android/local.properties

# Android signing keys (never commit keystore files)
*.jks
*.keystore
android/key.properties

# Google Services (Firebase — if added later)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Claude Code project settings (local tooling, not part of the project)
.claude/
